# Cache policy for Netlify / Cloudflare Pages.
# Assets are content-versioned via the ?v= query string in the HTML, so they
# can be cached hard. HTML must revalidate so deploys go live immediately.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
